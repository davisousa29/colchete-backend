# ── Aplicação ───────────────────────────────────────────────────────
APP_NAME="Colchete"
# Produção: production
APP_ENV=local
# Gerada em cada ambiente com: php artisan key:generate (nunca copiar de outro ambiente)
APP_KEY=
# Produção: false (com true, os erros mostram o stack trace para quem chamou a API)
APP_DEBUG=true
# Produção: https://api.<domínio>
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Logs ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
# Produção: daily (um arquivo por dia, apagando os mais antigos que LOG_DAILY_DAYS)
LOG_STACK=single
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Produção: info (mantém os registros de vencimento, exclusão e falhas de e-mail)
LOG_LEVEL=debug

# ── Banco de dados (PostgreSQL no Docker) ───────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agro_db
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ── Redis (serviço "redis" no Docker) ───────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ── E-mail ──────────────────────────────────────────────────────────
# Desenvolvimento: Mailtrap | Produção: provedor de e-mail escolhido
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Produção: nao-responda@<domínio>
MAIL_FROM_ADDRESS="nao-responda@exemplo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Autenticação (JWT) ──────────────────────────────────────────────
# Gerada em cada ambiente com: php artisan jwt:secret (nunca copiar de outro ambiente)
JWT_SECRET=

# ── Login com Google ────────────────────────────────────────────────
# ID do cliente OAuth cadastrado no Google Cloud (um por ambiente)
GOOGLE_CLIENT_ID=

# ── Asaas (pagamentos) ──────────────────────────────────────────────
# Desenvolvimento: sandbox | Produção: production
ASAAS_ENV=sandbox
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Chave da API (painel do Asaas > Integrações). Entre aspas simples, por causa do $ no início.
ASAAS_API_KEY=
# Token do webhook: o mesmo cadastrado na configuração do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=

# ── Fila de e-mails ─────────────────────────────────────────────────
# Ritmo de envio: MAIL_RATE_LIMIT e-mails a cada MAIL_RATE_SECONDS segundos.
# Mailtrap gratuito: 1 a cada 10. Produção: conforme o limite do provedor.
MAIL_RATE_LIMIT=1
MAIL_RATE_SECONDS=10
